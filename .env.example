# Copia este archivo como .env para docker-compose.yml (desarrollo/local).
# Nunca subas tu .env real al repositorio.

TIME_ZONE=America/Guatemala

# Puertos publicados en localhost.
API_HTTP_PORT=8080
WEB_HTTP_PORT=8082

# Contraseña del usuario 'sa' de SQL Server (mín. 8 chars, mayúscula, número y símbolo).
DB_PASSWORD=Local_Dev_Password_123

# Clave JWT de desarrollo (mín. 32 bytes). Genera una propia; no reutilices esta.
JWT_SECRET_KEY=dev-only-super-secret-key-change-me-32bytes-min

# Ruta al env.js del frontend. Por defecto usa el del repo; en un VPS apunta al del servidor.
# ENV_JS_PATH=./WebApp/public/assets/env.js
