# Referencia del .env de producción. "deploy/manage.py init" lo genera con secretos aleatorios;
# editar a mano solo lo necesario. NUNCA subir el .env real al repositorio. Proteger con chmod 600.

# Zona horaria de los contenedores (logs). La zona de la guía se configura en el panel (Ajustes).
TIME_ZONE=America/Guatemala

# Pin released images to an immutable SHA tag or digest; no Watchtower.
API_IMAGE=ghcr.io/efernandobl1/nostalgia-api:latest
WEB_IMAGE=ghcr.io/efernandobl1/nostalgia-web:latest
SQLSERVER_IMAGE=mcr.microsoft.com/mssql/server:2022-CU20-ubuntu-22.04
API_CPUS=4.0
MONITORING_NETWORK_NAME=monitoring-nostalgia

# ── Borde ──
# La webapp se publica SÓLO en localhost. El nginx del HOST (el que ya sirve tus
# otros proyectos en 80/443) termina TLS y enruta tu dominio hacia este puerto.
WEB_HTTP_PORT=8090
# URL pública con la que el navegador accede (tu dominio). La usa CORS.
APP_PUBLIC_URL=https://nostalgiatv.tudominio.com

# ── Secretos ──
DB_PASSWORD=reemplaza-con-un-password-sql-largo-y-aleatorio
# Al menos 32 bytes aleatorios, por ejemplo: openssl rand -hex 48
JWT_SECRET_KEY=reemplaza-con-un-secreto-jwt-largo-y-aleatorio
# Emisor/audiencia del JWT: string estable, NO depende de la IP/dominio.
JWT_ISSUER=nostalgiatv
JWT_AUDIENCE=nostalgiatv

# Provision nostalgia_app with db_datareader/db_datawriter only; never server roles.
# Provision nostalgia_migrator with db_owner on NostalgiaTV only, not sysadmin.
# These certificates must match the TLS certificate configured on SQL Server.
# Mount only the PUBLIC certificate in ./certificates/sqlserver/server.cer, never its private key.
DB_APP_CONNECTION_STRING='Server=sqlserver;Database=NostalgiaTV;User Id=nostalgia_app;Password=REPLACE_ME;Encrypt=Mandatory;TrustServerCertificate=False;ServerCertificate=/run/sqlserver/server.cer'
DB_MIGRATION_CONNECTION_STRING='Server=sqlserver;Database=NostalgiaTV;User Id=nostalgia_migrator;Password=REPLACE_ME;Encrypt=Mandatory;TrustServerCertificate=False;ServerCertificate=/run/sqlserver/server.cer'
# Initial "admin" password (12 to 128 characters), applied by the migrate service only while the
# administrator still has the seed placeholder. Remove it from .env after the first deployment.
BOOTSTRAP_ADMIN_PASSWORD=

# Scheduling preferences are configured in dashboard Settings and stored in SQL Server.

# ── Frontend ──
# env.js con apiUrl:'' (mismo origen). No necesita IP ni dominio.
ENV_JS_PATH=/opt/nostalgiatv/env.js

# ── Despliegue ──
# El workflow de despliegue corre "deploy/manage.py update" al fusionar a main: backup verificado,
# imágenes fijadas por SHA, migración aislada y chequeo de salud. A mano:
#   sudo python3 deploy/manage.py update /opt/nostalgiatv --release <sha>
# (Sin Watchtower, para no correr un contenedor con acceso a docker.sock.)

# ── Monitoreo (tu stack aparte, red externa 'monitoring-nostalgia') ──
# NostalgiaTV NO levanta Grafana/Loki/Alloy/Uptime Kuma: se conecta a tu stack de
# monitoreo ya existente vía la red externa. Creala si no existe:
#   docker network create monitoring-nostalgia
# Desde ese stack, en Uptime Kuma creá monitores HTTP hacia:
#   http://nostalgia-api:8080/health         (liveness de la API)
#   http://nostalgia-api:8080/health/ready   (readiness: conexión real a SQL Server)
#   http://nostalgia-web:8080/health         (frontend)
# En Grafana/Loki filtrá los logs con {container="nostalgia-api"}.
# Optional Google login. Register https://YOUR_DOMAIN/api/v1/auth/google/callback as the web OAuth redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional LAN HTTPS proxy; leave disabled when the host nginx already terminates TLS.
# COMPOSE_PROFILES=local-https
# LOCAL_HTTPS_HOST=192.168.1.10
# LOCAL_HTTPS_BIND_IP=192.168.1.10
# LOCAL_HTTPS_PORT=443
# Install only data/caddy/caddy/pki/authorities/local/root.crt in each client's CA store.
# Never distribute root.key, and never forward this local profile's port from the router.
