# Copiar como .env junto a docker-compose.production.yml en el servidor.
# NUNCA subir el .env real al repositorio. Genera cada secreto con valores largos y aleatorios.

TIME_ZONE=America/Guatemala

# ── Imágenes de GHCR (Watchtower vigila la etiqueta :latest) ──
API_IMAGE=ghcr.io/kfernandol/nostalgia-api:latest
WEB_IMAGE=ghcr.io/kfernandol/nostalgia-web:latest
SQLSERVER_IMAGE=mcr.microsoft.com/mssql/server:2022-latest

# ── Puertos publicados en el host ──
API_HTTP_PORT=8081
WEB_HTTP_PORT=8082

# ── URLs públicas (las usa CORS y el emisor/audiencia del JWT) ──
# Deben coincidir con cómo el navegador accede a cada servicio.
API_PUBLIC_URL=http://85.239.230.160:8081
WEB_PUBLIC_URL=http://85.239.230.160:8082

# ── Secretos ──
DB_PASSWORD=reemplaza-con-un-password-sql-largo-y-aleatorio
JWT_SECRET_KEY=reemplaza-con-un-secreto-jwt-largo-y-aleatorio

# ── Frontend ──
# Ruta en el servidor al env.js que apunta al API_PUBLIC_URL. Se monta de solo lectura.
ENV_JS_PATH=/opt/nostalgiatv/env.js

# ── Despliegue continuo (Watchtower, sin SSH) ──
# Ruta al config.json donde quedó guardado el 'docker login ghcr.io' (token classic).
DOCKER_CONFIG_PATH=/root/.docker/config.json
# Cada cuántos segundos Watchtower revisa GHCR por una nueva :latest.
WATCHTOWER_POLL_INTERVAL=60

# ── Monitoreo (Loki + Alloy + Grafana + Uptime Kuma, integrado en el compose) ──
# Grafana y Uptime Kuma se publican SOLO en localhost por defecto. Accedé por túnel
# SSH (ssh -L 3000:127.0.0.1:3000 servidor) o detrás de un reverse proxy.
# Para exponerlos directamente cambiá MONITORING_BIND a 0.0.0.0 (menos seguro).
MONITORING_BIND=127.0.0.1
GRAFANA_PORT=3000
UPTIME_KUMA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=reemplaza-con-un-password-largo-y-aleatorio

# Versiones de las imágenes de monitoreo (Dependabot las actualiza vía PR).
LOKI_IMAGE=grafana/loki:3.3.2
ALLOY_IMAGE=grafana/alloy:v1.5.1
GRAFANA_IMAGE=grafana/grafana:11.4.0
UPTIME_KUMA_IMAGE=louislam/uptime-kuma:1

# Desde la red 'monitoring' los servicios se resuelven por su nombre. En Uptime Kuma
# creá monitores HTTP(s) hacia:
#   http://webapi:8080/health         (liveness del proceso de la API)
#   http://webapi:8080/health/ready   (readiness: conexión real a SQL Server)
#   http://webapp/health              (frontend)
# Grafana ya trae Loki como datasource; explorá logs con {job="docker"} | container="nostalgia-api".
