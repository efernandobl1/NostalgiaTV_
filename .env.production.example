# Copiar como .env junto a docker-compose.production.yml en el servidor.
# NUNCA subir el .env real al repositorio. Genera cada secreto con valores largos y aleatorios.

TIME_ZONE=America/Guatemala

# ── Imágenes de GHCR (Watchtower vigila la etiqueta :latest) ──
API_IMAGE=ghcr.io/efernandobl1/nostalgia-api:latest
WEB_IMAGE=ghcr.io/efernandobl1/nostalgia-web:latest
SQLSERVER_IMAGE=mcr.microsoft.com/mssql/server:2022-latest

# ── Borde ──
# La webapp se publica SÓLO en localhost. El nginx del HOST (el que ya sirve tus
# otros proyectos en 80/443) termina TLS y enruta tu dominio hacia este puerto.
WEB_HTTP_PORT=8090
# URL pública con la que el navegador accede (tu dominio). La usa CORS.
APP_PUBLIC_URL=https://nostalgiatv.tudominio.com

# ── Secretos ──
DB_PASSWORD=reemplaza-con-un-password-sql-largo-y-aleatorio
JWT_SECRET_KEY=reemplaza-con-un-secreto-jwt-largo-y-aleatorio
# Emisor/audiencia del JWT: string estable, NO depende de la IP/dominio.
JWT_ISSUER=nostalgiatv

# ── Frontend ──
# env.js con apiUrl:'' (mismo origen). No necesita IP ni dominio.
ENV_JS_PATH=/opt/nostalgiatv/env.js

# ── Despliegue continuo (Watchtower, sin SSH) ──
DOCKER_CONFIG_PATH=/root/.docker/config.json   # donde quedó el 'docker login ghcr.io'
WATCHTOWER_POLL_INTERVAL=60                     # segundos entre chequeos de GHCR

# ── Monitoreo (Loki + Alloy + Grafana + Uptime Kuma, integrado) ──
# Grafana y Uptime Kuma se publican SOLO en localhost. Accedé por túnel SSH:
#   ssh -L 3000:127.0.0.1:3000 -L 3001:127.0.0.1:3001 usuario@TU_IP
MONITORING_BIND=127.0.0.1
GRAFANA_PORT=3000
UPTIME_KUMA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=reemplaza-con-un-password-largo-y-aleatorio

# Versiones de las imágenes de monitoreo (Dependabot las actualiza vía PR).
LOKI_IMAGE=grafana/loki:3.3.2
ALLOY_IMAGE=grafana/alloy:v1.5.1
GRAFANA_IMAGE=grafana/grafana:11.4.0
UPTIME_KUMA_IMAGE=louislam/uptime-kuma:1

# En Uptime Kuma creá monitores HTTP(s) hacia (desde la red 'monitoring'):
#   http://webapi:8080/health         (liveness de la API)
#   http://webapi:8080/health/ready   (readiness: conexión real a SQL Server)
#   http://webapp/health              (frontend)
# En Grafana explorá logs con {container="nostalgia-api"} (datasource Loki ya provisto).
