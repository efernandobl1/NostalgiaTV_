{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // Secretos reales SOLO en appsettings.Local.json (ignorado por git) o en User Secrets.
  // Estos valores son de desarrollo desechables y no deben usarse en producción.
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=localhost\\SQLEXPRESS;Initial Catalog=NostalgiaTV;Integrated Security=True;Pooling=False;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Key": "dev-only-super-secret-key-change-me-32bytes-min",
    "Issuer": "https://localhost:7050",
    "Audience": "https://localhost:7050"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "System": "Warning"
      }
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://127.0.0.1:54636",
      "http://localhost:4200"
    ]
  },
  "FileUpload": {
    "MaxFileSizeMB": 5,
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".webp" ]
  },
  "MediaSettings": {
    "BasePath": "wwwroot/uploads"
  },
  "FFmpeg": {
    "BinaryFolder": "C:/ffmpeg/bin"
  }
}
